# =============================================================================
#  MM CONSULTANCY SOLUTIONS — CONFIGURATION KEY REFERENCE
# =============================================================================
#  This file is a REFERENCE ONLY. It documents every value the application
#  reads, with its default. It is NOT loaded by the code and must NOT be
#  copied to config.php — its KEY=value format is not valid PHP, so doing so
#  would leave every constant undefined and the site would fail to connect.
#
#  To configure the app, copy the real PHP template instead:
#
#      cp config.example.php config.php
#
#  Then edit config.php. config.php is git-ignored; never commit it.
# =============================================================================

# -------------------------------------------------------------------
#  1. DATABASE — MySQL connection  (config.php section 1)
# -------------------------------------------------------------------
# DB_HOST=localhost
# DB_NAME=mmcs_db
# DB_USER=root
# DB_PASS=

# -------------------------------------------------------------------
#  2. SMTP MAIL — used for contact/inquiry form emails  (section 3)
# -------------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your-email@gmail.com
# MAIL_PASS=your-gmail-app-password
# MAIL_FROM=mmconsultancysolutions@gmail.com
# MAIL_FROM_NAME=MMCS Web Desk

# -------------------------------------------------------------------
#  3. FILE UPLOADS — size limit  (section 4)
# -------------------------------------------------------------------
# MAX_FILE_SIZE=5242880  (5 MB in bytes)

# -------------------------------------------------------------------
#  4. SESSION — idle timeout in seconds  (section 5)
# -------------------------------------------------------------------
# SESSION_TIMEOUT=1800  (30 minutes)

# -------------------------------------------------------------------
#  5. DEV MODE — set false on production  (section 6)
# -------------------------------------------------------------------
# DEV_MODE=false
